+def x224_cc(dst_ref: int = 0x0000, src_ref: int = 0x1234, neg_rsp: bool = True) -> bytes:
+    """X.224 Connection Confirm, as Windows sends it.
+
+    DST-REF echoes the client's SRC-REF; SRC-REF is the server's own (0x1234).
+    RDP_NEG_RSP is present only if the request carried RDP_NEG_REQ
+    (MS-RDPBCGR 2.2.1.2); a legacy request gets the 11-byte legacy confirm.
+    LI counts the header after itself: 6, or 14 with RDP_NEG_RSP.
+    """
+    body = struct.pack(">BHHB", 0xD0, dst_ref, src_ref, 0x00)
+    if neg_rsp:
+        body += struct.pack("<BBHI", 0x02, 0x00, 0x0008, 0x00000000)
+    return tpkt_wrap(struct.pack(">B", len(body)) + body)
 
 
